# Copy to .env.local and fill in. Never commit real values.
# Supabase (create the project yourself: Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never NEXT_PUBLIC_
# Stripe: use TEST keys until deploy
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Resend: verify your own sending domain first
RESEND_API_KEY=
EMAIL_FROM=
# App
APP_URL=http://localhost:3000
CRON_SECRET=                          # 24+ random characters; the scheduler sends it as a bearer token
